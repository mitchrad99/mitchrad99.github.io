---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPublishedPosts, postHref } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, i) => {
    // posts are newest-first: next (i-1) is newer, prev (i+1) is older
    const newer = posts[i - 1];
    const older = posts[i + 1];
    return {
      params: { slug: post.id },
      props: {
        post,
        next: newer ? { href: postHref(newer), title: newer.data.title } : null,
        prev: older ? { href: postHref(older), title: older.data.title } : null,
      },
    };
  });
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  heroImage={post.data.heroImage}
  prev={prev}
  next={next}
>
  <Content />
</PostLayout>
