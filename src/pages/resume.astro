---
import BaseLayout from '../layouts/BaseLayout.astro';

// PLACEHOLDER CONTENT — replace with real details (or wire this into PagesCMS later).
// Drop a PDF at /public/resume.pdf to enable the download link.
const experience = [
  {
    role: 'Job Title',
    org: 'Company',
    dates: 'Year – Present',
    points: [
      'What you did in this role.',
      'A specific project and how it went.',
    ],
  },
  {
    role: 'Earlier Job Title',
    org: 'Company',
    dates: 'Year – Year',
    points: ['What you did here.'],
  },
];

const education = [
  {
    credential: 'B.S. in Data Science',
    org: 'The Ohio State University',
    dates: 'Year',
    detail: 'Relevant coursework, honors, or activities.',
  },
];

const skills = [
  { group: 'Languages', items: 'Python, R, SQL' },
  { group: 'Tools', items: 'pandas, scikit-learn, Tableau, Git' },
  { group: 'Focus areas', items: 'Analytics, forecasting, supply chain / operations research' },
];
---

<BaseLayout title="Resume" description="Mitch Radakovich's resume.">
  <section class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow">Resume</p>
        <h1>Resume</h1>
      </div>
      <a class="download" href="/resume.pdf">Download PDF ↓</a>
    </div>

    <p class="note">
      <strong>Placeholder.</strong> Replace the content in
      <code>src/pages/resume.astro</code> and add <code>public/resume.pdf</code>.
    </p>

    <div class="section">
      <h2>Experience</h2>
      {
        experience.map((job) => (
          <div class="entry">
            <div class="entry-head">
              <h3>
                {job.role} · <span class="org">{job.org}</span>
              </h3>
              <span class="dates">{job.dates}</span>
            </div>
            <ul>
              {job.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="section">
      <h2>Education</h2>
      {
        education.map((ed) => (
          <div class="entry">
            <div class="entry-head">
              <h3>
                {ed.credential} · <span class="org">{ed.org}</span>
              </h3>
              <span class="dates">{ed.dates}</span>
            </div>
            <p>{ed.detail}</p>
          </div>
        ))
      }
    </div>

    <div class="section">
      <h2>Skills</h2>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>{s.items}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap {
    padding-top: var(--space-2xl);
    max-width: 52rem;
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-m);
  }
  h1 {
    margin-top: var(--space-2xs);
  }
  .download {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    white-space: nowrap;
  }
  .note {
    margin-top: var(--space-m);
    padding: var(--space-s);
    background: var(--paper-sunk);
    border: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .section {
    margin-top: var(--space-xl);
  }
  .section > h2 {
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--rule);
  }
  .entry {
    margin-top: var(--space-m);
  }
  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs);
  }
  .entry-head h3 {
    font-size: var(--step-1);
  }
  .org {
    color: var(--ink-soft);
  }
  .dates {
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  .entry ul {
    margin-top: var(--space-2xs);
    padding-left: 1.2em;
    color: var(--ink-soft);
  }
  .entry li + li {
    margin-top: 0.3em;
  }
  .skills {
    margin-top: var(--space-m);
  }
  .skills > div {
    display: flex;
    gap: var(--space-m);
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--rule);
  }
  .skills dt {
    flex: 0 0 9rem;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .skills dd {
    margin: 0;
    color: var(--ink-soft);
  }
</style>
