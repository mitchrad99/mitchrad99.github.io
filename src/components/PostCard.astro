---
import FormattedDate from './FormattedDate.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  image?: string;
}
const { href, title, description, pubDate, tags = [], image } = Astro.props;
---

<article class="card">
  <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
    {
      image ? (
        <img src={image} alt="" loading="lazy" />
      ) : (
        <span class="thumb-empty">{tags[0] ?? 'Essay'}</span>
      )
    }
  </a>
  <div class="body">
    <p class="meta"><FormattedDate date={pubDate} /></p>
    <h2><a class="title-link" href={href}>{title}</a></h2>
    <p class="excerpt">{description}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-columns: 15rem 1fr;
    align-items: start;
    border: 1px solid var(--rule);
    background: var(--paper);
    transition: border-color 0.15s ease;
  }
  .card + .card {
    margin-top: var(--space-m);
  }
  .card:hover {
    border-color: var(--accent);
  }

  .thumb {
    display: block;
  }
  .thumb img,
  .thumb-empty {
    width: 100%;
    aspect-ratio: 3 / 2;
    height: auto;
    object-fit: cover;
    display: block;
  }
  .thumb-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper-sunk);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .body {
    padding: var(--space-m);
  }
  .meta {
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  h2 {
    margin-top: var(--space-2xs);
    font-size: var(--step-1);
  }
  .title-link {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-decoration: none;
  }
  /* whole card is the click target */
  .title-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card:hover .title-link {
    color: var(--accent);
  }
  .excerpt {
    margin-top: var(--space-xs);
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 38rem) {
    .card {
      grid-template-columns: 1fr;
    }
    .thumb {
      border-bottom: 1px solid var(--rule);
    }
    .thumb img,
    .thumb-empty {
      aspect-ratio: 16 / 9;
    }
  }
</style>
